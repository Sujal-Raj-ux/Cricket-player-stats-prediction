# Copy to .env and fill in. FastAPI can load via: pip install python-dotenv && dotenv in uvicorn
# Or: export DATABASE_URL before starting uvicorn

# Deployed front-end origins (comma-separated, no spaces). Required for browser calls to the API.
# Example: CORS_ORIGINS=https://your-app.netlify.app,https://www.yourdomain.com

# Supabase → Project Settings → Database → Connection string (URI)
# Use Session mode (port 5432) or Transaction pooler (6543) — match SSL settings.
# Copy the URI from Supabase (Database settings). Put the real value in `.env` only (gitignored).
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
